# Horizon's web build on Apache (web/README.md). web/build.sh copies this into web/dist as
# .htaccess; Apache reads it where the folder allows overrides (AllowOverride All, or at least
# FileInfo, Indexes and AuthConfig).

# The module streams in as it compiles only when it is served as application/wasm.
AddType application/wasm .wasm
AddType text/javascript .js

# No listing: the resources zip is found by its name only.
Options -Indexes

# The module and the page compress well; the resources zip is compressed already.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/wasm text/javascript text/html application/json
  SetEnvIfNoCase Request_URI "\.zip$" no-gzip
</IfModule>

# Every build replaces the page and the module: ask each time (an unchanged file is a 304).
# Cross-origin isolation (COOP and COEP) on every response: the threaded build's shared memory
# exists only on an isolated page, so without mod_headers only a --no-threads build runs.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|json|wasm)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Embedder-Policy "require-corp"
</IfModule>

# local-resources.zip holds files prepared from your own copy of Minecraft. Keep this server to
# yourself; to ask for a password, make one (htpasswd -c /etc/apache2/horizon.htpasswd NAME)
# and uncomment:
#AuthType Basic
#AuthName "Horizon"
#AuthUserFile /etc/apache2/horizon.htpasswd
#Require valid-user

# The WebSocket relay (web/README.md, Multiplayer) at wss://<this site>/relay: run
# horizon-web-relay on this machine (it listens on 127.0.0.1:8081), enable mod_rewrite,
# mod_proxy and mod_proxy_wstunnel, and uncomment. The page's ?target= goes along. The
# last two lines pass on its downloads of servers' resource packs (?download=).
#RewriteEngine On
#RewriteCond %{HTTP:Upgrade} =websocket [NC]
#RewriteRule ^relay/?$ ws://127.0.0.1:8081/ [P,L]
#RewriteCond %{QUERY_STRING} (^|&)download=
#RewriteRule ^relay/?$ http://127.0.0.1:8081/ [P,L]
